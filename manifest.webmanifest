{
  "name": "AIMarker",
  "short_name": "AIMarker",
  "description": "AI로 만든 이미지와 글에 지문 마크를 자동으로. AI 표시 자동화, 지문 마크 넣기, AI 검색 노출 진단, 글 검사를 한곳에서. 파일과 글은 저장하지 않습니다.",
  "id": "/",
  "start_url": "/?src=app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FFFFFF",
  "theme_color": "#FFFFFF",
  "lang": "ko",
  "icons": [
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "빠른 지문 마크",
      "short_name": "지문 마크",
      "url": "/mark/?src=app#auto"
    },
    {
      "name": "AI 표시 자동화",
      "short_name": "AI 표시",
      "url": "/label/?src=app"
    },
    {
      "name": "AI 검색 노출 진단",
      "short_name": "AI 검색",
      "url": "/geo/?src=app"
    },
    {
      "name": "글 검사와 휴머나이징",
      "short_name": "글 검사",
      "url": "/humanize/?src=app"
    }
  ],
  "share_target": {
    "action": "/mark/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "img",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp"
          ]
        }
      ]
    }
  }
}