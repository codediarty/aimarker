{
 "openapi": "3.1.0",
 "info": {
  "title": "AIMarker API",
  "version": "2026.10.16",
  "summary": "AI 콘텐츠 검수 · 표시 · 승인 · 증거 원장 API",
  "description": "AIMarker는 기업의 AI 콘텐츠를 분석하고, 검수하고, 기록하는 AI 콘텐츠 신뢰 인프라입니다. 이 API로 광고 · 상세페이지 · SNS 문구를 한국 광고 규칙(KR-AdLaw 규칙 팩)과 협찬 · 가상인물 · AI 표시 기준으로 검수하고, 표시 문구를 받고, 광고주 승인 링크와 증거 원장을 다룹니다.\n\n- 모든 요청은 같은 주소(/exec)로 POST 하고 본문의 action 으로 동작을 고릅니다. 본문은 JSON 문자열, Content-Type: text/plain.\n- 서버가 302 로 결과 주소를 알려 주므로 리다이렉트를 따라가세요(POST → GET).\n- 결과는 위험 후보와 근거이며 법률 자문이 아닙니다. 검수 문구는 저장하지 않습니다.\n- AI 에이전트용: MCP 서버 https://aimarker.kr/mcp/aimarker-mcp-1.0.0.tgz · 한 파일 설명서 https://aimarker.kr/llms-full.txt",
  "contact": {
   "name": "AIMarker",
   "email": "contact@skkc.co.kr",
   "url": "https://aimarker.kr/developers/"
  }
 },
 "externalDocs": {
  "description": "API · AI 연동 안내",
  "url": "https://aimarker.kr/developers/"
 },
 "servers": [
  {
   "url": "https://script.google.com/macros/s/AKfycbw3ZPLXHv92tfNVs7caH-Bf1OvMesqh0RfR8y4LCsT5DaE3otEbGWhyFLIY6FqoBEY",
   "description": "운영 서버(302 넘겨주기를 따라가야 함)"
  }
 ],
 "paths": {
  "/exec": {
   "post": {
    "operationId": "aimarker",
    "summary": "action 으로 고르는 AIMarker 요청",
    "description": "am.check(문구 검수) · am.batch(20건 일괄) · am.label(표시 문구) · am.scan(사이트 진단) · am.share(광고주 승인 링크) · am.status(승인 상태) · am.stamp(원장 기록) · am.verify(원장 확인)",
    "requestBody": {
     "required": true,
     "content": {
      "text/plain": {
       "schema": {
        "oneOf": [
         {
          "$ref": "#/components/schemas/CheckRequest"
         },
         {
          "$ref": "#/components/schemas/BatchRequest"
         },
         {
          "$ref": "#/components/schemas/LabelRequest"
         },
         {
          "$ref": "#/components/schemas/ScanRequest"
         },
         {
          "$ref": "#/components/schemas/ShareRequest"
         },
         {
          "$ref": "#/components/schemas/StatusRequest"
         },
         {
          "$ref": "#/components/schemas/StampRequest"
         },
         {
          "$ref": "#/components/schemas/VerifyRequest"
         }
        ],
        "discriminator": {
         "propertyName": "action",
         "mapping": {
          "am.check": "#/components/schemas/CheckRequest",
          "am.batch": "#/components/schemas/BatchRequest",
          "am.label": "#/components/schemas/LabelRequest",
          "am.scan": "#/components/schemas/ScanRequest",
          "am.share": "#/components/schemas/ShareRequest",
          "am.status": "#/components/schemas/StatusRequest",
          "am.stamp": "#/components/schemas/StampRequest",
          "am.verify": "#/components/schemas/VerifyRequest"
         }
        }
       },
       "examples": {
        "check": {
         "summary": "화장품 · AI 모델 광고 문구 검수",
         "value": {
          "action": "am.check",
          "key": "amk_0123456789abcdef0123456789abcdef",
          "text": "AI 모델 지아가 직접 써 본 재생 크림! 부작용 없는 순한 성분으로 바르자마자 주름이 사라져요. 국내 최초 특허 성분.",
          "ind": "",
          "flags": {
           "aiPerson": true,
           "aiMedia": true
          }
         }
        },
        "batch": {
         "summary": "일괄 검수",
         "value": {
          "action": "am.batch",
          "key": "amk_0123456789abcdef0123456789abcdef",
          "items": [
           {
            "id": "p-1",
            "text": "당뇨에 좋은 여주차",
            "ind": "food"
           },
           {
            "id": "p-2",
            "text": "부드러운 니트"
           }
          ]
         }
        },
        "stamp": {
         "summary": "원장 기록",
         "value": {
          "action": "am.stamp",
          "key": "amk_0123456789abcdef0123456789abcdef",
          "h": "8c3c751724e5408a7f47ff552212d26b41a70d75aa810234717d4a855b18c32d",
          "k": "report",
          "n": 12
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "ok:true 와 결과, 또는 ok:false · code · message",
      "content": {
       "application/json": {
        "schema": {
         "oneOf": [
          {
           "$ref": "#/components/schemas/CheckResult"
          },
          {
           "$ref": "#/components/schemas/BatchResult"
          },
          {
           "$ref": "#/components/schemas/LabelResult"
          },
          {
           "$ref": "#/components/schemas/ScanResult"
          },
          {
           "$ref": "#/components/schemas/ShareResult"
          },
          {
           "$ref": "#/components/schemas/StatusResult"
          },
          {
           "$ref": "#/components/schemas/StampResult"
          },
          {
           "$ref": "#/components/schemas/VerifyResult"
          },
          {
           "$ref": "#/components/schemas/Error"
          }
         ]
        },
        "examples": {
         "check": {
          "summary": "실제 결과(줄임)",
          "value": {
           "ok": true,
           "pack": {
            "name": "KR-AdLaw",
            "ver": "2026.10.15",
            "rules": 66
           },
           "ind": "cos",
           "indName": "화장품",
           "auto": true,
           "score": 100,
           "decision": "expert",
           "counts": {
            "high": 5,
            "mid": 4,
            "info": 0
           },
           "findings": [
            {
             "id": "K01",
             "cat": 3,
             "lv": 3,
             "s": 17,
             "e": 19,
             "re": 19,
             "t": "재생",
             "why": "화장품에 치료 · 재생처럼 의약품 효능을 표현하면 의약품으로 오인하게 하는 광고입니다.",
             "law": "화장품법 제13조 · 시행규칙 별표 5",
             "reps": [
              "케어",
              "관리"
             ],
             "tip": "치료 · 재생 대신 '케어' · '보습' · '피부 컨디션' 같은 화장품 표현으로 바꾸세요."
            },
            {
             "id": "D21",
             "cat": 1,
             "lv": 2,
             "s": -1,
             "e": -1,
             "t": "",
             "why": "AI로 만든 이미지 · 영상이 들어가는데 그 사실을 밝히는 말이 없습니다.",
             "law": "AI기본법 제31조 · 표시광고법(기만)",
             "reps": [
              "(AI로 만든 이미지) "
             ],
             "tip": "이미지 · 영상 가까이에 'AI로 만든 이미지'를 밝히세요."
            }
           ],
           "labels": [
            {
             "kind": "person",
             "text": "[가상인물]",
             "long": "이 광고에는 AI로 만든 가상인물이 등장합니다.",
             "where": "영상은 인물 가까이 화면 안, 글은 첫머리"
            }
           ],
           "ms": 184
          }
         },
         "error": {
          "summary": "키 오류",
          "value": {
           "ok": false,
           "code": "KEY",
           "message": "API 키가 올바르지 않습니다."
          }
         }
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Finding": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "description": "규칙 번호(예: C01 · F04 · K01 · D21)"
     },
     "cat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "description": "1 AI 사용 근거 · 표시 · 2 가상인물 · 딥페이크 · 3 업종별 금지 · 과장 · 4 추천 · 보증(협찬) · 5 저작권 · 초상권 단서 · 6 브랜드 가이드"
     },
     "lv": {
      "type": "integer",
      "enum": [
       1,
       2,
       3
      ],
      "description": "3 높음 · 2 주의 · 1 참고"
     },
     "s": {
      "type": "integer",
      "description": "보낸 문구에서 시작 위치(필수 표시가 빠진 경우 -1)"
     },
     "e": {
      "type": "integer",
      "description": "끝 위치"
     },
     "re": {
      "type": "integer",
      "description": "바꿀 때 함께 바꿀 끝 위치(조사 포함)"
     },
     "t": {
      "type": "string",
      "description": "찾은 표현"
     },
     "why": {
      "type": "string"
     },
     "law": {
      "type": "string",
      "description": "근거 법령 · 지침"
     },
     "reps": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "바꿀 말 후보. '(삭제)'는 빼기, 빈 배열은 사람이 다시 쓸 표현"
     },
     "tip": {
      "type": "string"
     }
    }
   },
   "Label": {
    "type": "object",
    "properties": {
     "kind": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "long": {
      "type": "string"
     },
     "where": {
      "type": "string"
     },
     "iptc": {
      "type": "string"
     }
    }
   },
   "CheckRequest": {
    "type": "object",
    "title": "am.check",
    "description": "문구 하나 검수",
    "properties": {
     "action": {
      "type": "string",
      "const": "am.check"
     },
     "key": {
      "type": "string",
      "pattern": "^amk_[0-9a-f]{32}$",
      "description": "API 키(무료 하루 300회). https://aimarker.kr/developers/#key"
     },
     "text": {
      "type": "string",
      "maxLength": 5000,
      "description": "검수할 문구"
     },
     "ind": {
      "type": "string",
      "enum": [
       "",
       "auto",
       "gen",
       "food",
       "hfood",
       "cos",
       "med",
       "fin"
      ],
      "description": "업종 규칙 팩. 빈 값 · auto 는 글로 자동 판별. gen 일반 상품 · food 일반식품 · hfood 건강기능식품 · cos 화장품 · med 의료 · fin 금융"
     },
     "flags": {
      "type": "object",
      "description": "콘텐츠 정보",
      "properties": {
       "sponsored": {
        "type": "boolean",
        "description": "대가를 받은 콘텐츠"
       },
       "aiPerson": {
        "type": "boolean",
        "description": "AI로 만든 인물 · 목소리 등장"
       },
       "aiMedia": {
        "type": "boolean",
        "description": "AI로 만든 이미지 · 영상 사용"
       }
      }
     },
     "guide": {
      "type": "object",
      "description": "브랜드 정책",
      "properties": {
       "ban": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "쓰지 않을 말"
       },
       "must": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "꼭 넣을 문구"
       }
      }
     }
    },
    "required": [
     "action",
     "key",
     "text"
    ]
   },
   "BatchRequest": {
    "type": "object",
    "title": "am.batch",
    "description": "20건까지 한 번에 검수(한도는 문구 수만큼)",
    "properties": {
     "action": {
      "type": "string",
      "const": "am.batch"
     },
     "key": {
      "type": "string",
      "pattern": "^amk_[0-9a-f]{32}$",
      "description": "API 키(무료 하루 300회). https://aimarker.kr/developers/#key"
     },
     "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string"
        },
        "text": {
         "type": "string",
         "maxLength": 5000
        },
        "ind": {
         "type": "string",
         "enum": [
          "",
          "auto",
          "gen",
          "food",
          "hfood",
          "cos",
          "med",
          "fin"
         ],
         "description": "업종 규칙 팩. 빈 값 · auto 는 글로 자동 판별. gen 일반 상품 · food 일반식품 · hfood 건강기능식품 · cos 화장품 · med 의료 · fin 금융"
        },
        "flags": {
         "type": "object",
         "description": "콘텐츠 정보",
         "properties": {
          "sponsored": {
           "type": "boolean",
           "description": "대가를 받은 콘텐츠"
          },
          "aiPerson": {
           "type": "boolean",
           "description": "AI로 만든 인물 · 목소리 등장"
          },
          "aiMedia": {
           "type": "boolean",
           "description": "AI로 만든 이미지 · 영상 사용"
          }
         }
        }
       },
       "required": [
        "text"
       ]
      }
     },
     "guide": {
      "type": "object",
      "description": "브랜드 정책",
      "properties": {
       "ban": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "쓰지 않을 말"
       },
       "must": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "꼭 넣을 문구"
       }
      }
     }
    },
    "required": [
     "action",
     "key",
     "items"
    ]
   },
   "LabelRequest": {
    "type": "object",
    "title": "am.label",
    "description": "붙일 표시 문구(한국AI윤리위원회 기준)",
    "properties": {
     "action": {
      "type": "string",
      "const": "am.label"
     },
     "key": {
      "type": "string",
      "pattern": "^amk_[0-9a-f]{32}$",
      "description": "API 키(무료 하루 300회). https://aimarker.kr/developers/#key"
     },
     "kind": {
      "type": "string",
      "enum": [
       "image",
       "video",
       "person",
       "text",
       "sponsor"
      ]
     },
     "level": {
      "type": "string",
      "enum": [
       "gen",
       "edit"
      ]
     }
    },
    "required": [
     "action",
     "key",
     "kind"
    ]
   },
   "ScanRequest": {
    "type": "object",
    "title": "am.scan",
    "description": "공개된 첫 화면 보수적 진단(10~20초)",
    "properties": {
     "action": {
      "type": "string",
      "const": "am.scan"
     },
     "key": {
      "type": "string",
      "pattern": "^amk_[0-9a-f]{32}$",
      "description": "API 키(무료 하루 300회). https://aimarker.kr/developers/#key"
     },
     "url": {
      "type": "string",
      "description": "사이트 주소"
     }
    },
    "required": [
     "action",
     "key",
     "url"
    ]
   },
   "ShareRequest": {
    "type": "object",
    "title": "am.share",
    "description": "광고주 승인 링크 만들기(문구 · 요약 90일 보관)",
    "properties": {
     "action": {
      "type": "string",
      "const": "am.share"
     },
     "key": {
      "type": "string",
      "pattern": "^amk_[0-9a-f]{32}$",
      "description": "API 키(무료 하루 300회). https://aimarker.kr/developers/#key"
     },
     "data": {
      "type": "object",
      "properties": {
       "title": {
        "type": "string"
       },
       "brand": {
        "type": "string"
       },
       "channel": {
        "type": "string"
       },
       "ind": {
        "type": "string"
       },
       "copy": {
        "type": "string",
        "maxLength": 3000
       },
       "score": {
        "type": "integer"
       },
       "dec": {
        "type": "string"
       },
       "from": {
        "type": "string"
       },
       "ver": {
        "type": "string"
       },
       "h": {
        "type": "string",
        "description": "문구 SHA-256"
       },
       "fnd": {
        "type": "array",
        "maxItems": 30,
        "items": {
         "type": "object",
         "properties": {
          "lv": {
           "type": "integer"
          },
          "cat": {
           "type": "integer"
          },
          "why": {
           "type": "string"
          },
          "t": {
           "type": "string"
          },
          "law": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    },
    "required": [
     "action",
     "key",
     "data"
    ]
   },
   "StatusRequest": {
    "type": "object",
    "title": "am.status",
    "description": "승인 상태 받아 오기",
    "properties": {
     "action": {
      "type": "string",
      "const": "am.status"
     },
     "key": {
      "type": "string",
      "pattern": "^amk_[0-9a-f]{32}$",
      "description": "API 키(무료 하루 300회). https://aimarker.kr/developers/#key"
     },
     "ids": {
      "type": "array",
      "maxItems": 60,
      "items": {
       "type": "string",
       "pattern": "^AP\\d{6}-[A-Z0-9]{8}$"
      }
     }
    },
    "required": [
     "action",
     "key",
     "ids"
    ]
   },
   "StampRequest": {
    "type": "object",
    "title": "am.stamp",
    "description": "증거 원장에 해시 기록",
    "properties": {
     "action": {
      "type": "string",
      "const": "am.stamp"
     },
     "key": {
      "type": "string",
      "pattern": "^amk_[0-9a-f]{32}$",
      "description": "API 키(무료 하루 300회). https://aimarker.kr/developers/#key"
     },
     "h": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256(내용은 보내지 않음)"
     },
     "n": {
      "type": "integer"
     },
     "k": {
      "type": "string",
      "enum": [
       "report",
       "version",
       "approval"
      ]
     }
    },
    "required": [
     "action",
     "key",
     "h"
    ]
   },
   "VerifyRequest": {
    "type": "object",
    "title": "am.verify",
    "description": "원장 확인(h 또는 id)",
    "properties": {
     "action": {
      "type": "string",
      "const": "am.verify"
     },
     "key": {
      "type": "string",
      "pattern": "^amk_[0-9a-f]{32}$",
      "description": "API 키(무료 하루 300회). https://aimarker.kr/developers/#key"
     },
     "h": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "id": {
      "type": "string"
     }
    },
    "required": [
     "action",
     "key"
    ]
   },
   "CheckResult": {
    "type": "object",
    "title": "CheckResult",
    "properties": {
     "ok": {
      "const": true
